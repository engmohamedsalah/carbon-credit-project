# Copy to backend/.env and fill in real values. backend/.env is gitignored — never commit it.

# --- Database ---
# The backend uses SQLite. Absolute path recommended in containers (mount a persistent volume here).
# Leave unset to use the repo-local default (../database/carbon_credits.db).
# DATABASE_PATH=/data/carbon_credits.db

# --- Auth ---
# Opaque random tokens are used (NOT JWT). SECRET_KEY is reserved for future use.
SECRET_KEY=
# Token lifetime in minutes (default 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
# Comma-separated allowed origins. Add your deployed frontend URL here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- First-run admin seed ---
# An admin is created on first startup ONLY if the users table is empty and both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Blockchain (optional) ---
# Certification is DISABLED unless all three are provided (RPC + key + deployed contract address).
# Default RPC targets the Polygon Amoy testnet (Mumbai was deprecated in 2024).
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
